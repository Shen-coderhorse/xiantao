# 本地敏感配置模板：复制为 xiantao-server/application-local.yml 后填入真实值
# application-local.yml 已被 .gitignore 忽略，禁止提交
# 也可改用环境变量：XIANTAO_DB_USERNAME / XIANTAO_DB_PASSWORD / XIANTAO_JWT_SECRET
spring:
  datasource:
    username: <本地MySQL用户名>
    password: "<本地MySQL密码>"

jwt:
  # 生成高熵密钥示例：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
  secret: "<至少48字节随机值，禁止使用曾入库的旧密钥>"
